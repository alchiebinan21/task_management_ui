# Laravel API (tasks CRUD — browser calls this directly)
# Use your local Laravel URL, e.g. php artisan serve or Laravel Herd/Valet
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api

# Note: MCP_API_KEY is NOT set in this file.
# Configure it in task_management_app, task_management_mcp, and task_management_agent .env
# (same value in all three). See README.md → "MCP API key".

# Task Agent proxy (server-side only — Nuxt proxies /api/task and /api/rag to this URL)
# NUXT_TASK_AGENT_URL=http://127.0.0.1:8001

# Client-side API paths (defaults are same-origin proxies; usually leave as-is)
# NUXT_PUBLIC_TASK_BASE_URL=/api/task
# NUXT_PUBLIC_RAG_BASE_URL=/api/rag
